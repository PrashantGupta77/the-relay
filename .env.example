# Application
APP_NAME=The Relay
APP_ENV=development
DEBUG=true

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_CHUNK_SIZE=600
DEFAULT_TOP_K=5

# Pipeline
REQUEST_TIMEOUT_SECONDS=20
MAX_PROVIDER_RETRIES=2
MAX_VERIFICATION_REPAIRS=1

# Stand-in
STANDIN_ENABLED=true
STANDIN_BASE_LATENCY_MS=500
STANDIN_FAILURE_RATE=0.02
STANDIN_MAX_CONCURRENCY=5